# Public site URL (used for metadata, sitemap, Stripe return URL fallback)
NEXT_PUBLIC_SITE_URL=https://strategy.north-ai.com

# --- Stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# From the webhook endpoint you create for https://<domain>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Meta Pixel + Conversions API ----------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
META_CAPI_TOKEN=EAAB...
# Optional: Events Manager > Test events code (remove in production)
META_TEST_EVENT_CODE=
# Optional: Graph API version (default v24.0)
META_GRAPH_API_VERSION=v24.0
# Show the cookie banner and only load Pixel / send CAPI after consent (UK/EU). "false" disables gating.
NEXT_PUBLIC_REQUIRE_CONSENT=true

# --- CRM ------------------------------------------------------------------
# Any endpoint that accepts a JSON POST: GoHighLevel inbound webhook, HubSpot workflow webhook,
# Zapier/Make catch hook, Airtable automation, etc. See README "CRM payload".
CRM_WEBHOOK_URL=
# Optional shared secret, sent as the X-Webhook-Secret header
CRM_WEBHOOK_SECRET=

# --- Calendly -------------------------------------------------------------
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/rishi-north-ai/30-min-meeting

# --- Content --------------------------------------------------------------
NEXT_PUBLIC_SPOTS_LEFT=6
NEXT_PUBLIC_SPOTS_CAPACITY=10
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_COOKIE_URL=
